    <string name="information_title">Informasjon</string>
    <string name="team_title">Teamet</string>
    <string name="about_team_text">Vi er en gruppe engasjerte og kreative IN2000-studenter som jobber sammen for å lage en informativ og brukervennlig skredvarsling-app. Målet vårt har vært å lage et pålitelig verktøy som hjelper brukere å ta tryggere beslutninger når de ferdes i områder med potensiell skredfare. Denne siden gir generell informasjon om skredfaregrader og hva de betyr. Gå tilbake til hjemskjermen eller kartet for hovedfunksjonene.</string>

    <string name="avalanche_info_title">Skredinformasjon</string>
    <string name="avalanche_general_info_text">Skred har blitt stadig mer vanlig etter hvert som klimaendringer påvirker fjellområder. Når du er ute og utforsker naturen, er det viktig å holde seg informert og prioritere sikkerhet. Derfor laget vi denne appen: for å hjelpe deg å ta tryggere valg og nyte tiden utendørs.</string>

    <string name="danger_levels_title">Skredfaregrader</string>

    <string name="danger_level_0_number">\?</string>
    <string name="danger_level_0_title">- Ukjent</string>
    <string name="danger_level_0_description">Vi har ikke tilstrekkelige målinger for det valgte området.</string>

    <string name="danger_level_1_number">1</string>
    <string name="danger_level_1_title">- Lav</string>
    <string name="danger_level_1_description">Generelt stabile forhold.\n\nUtløsning er vanligvis kun mulig ved stor tilleggsbelastning i isolerte områder med svært bratt terreng. Kun små og middels store naturlige skred er mulig.\n\nTypiske faresignaler:\nSjelden noen faresignaler.\n\nVarslet rundt 20% av vintersesongen. Rundt 5% av skredulykker.</string>

    <string name="danger_level_2_number">2</string>
    <string name="danger_level_2_title">- Moderat</string>
    <string name="danger_level_2_description">Økte skredforhold i enkelte terrengformasjoner.\n\nUtløsning er mulig, hovedsakelig ved stor tilleggsbelastning, spesielt i bratte heng som er angitt. Svært store naturlige skred er lite sannsynlig.\n\nTypiske faresignaler:\nOfte ingen faresignaler, men det betyr ikke nødvendigvis at det er trygt. Vær ekstra oppmerksom dersom vedvarende svakt lag er et av skredproblemene.\n\nVarslet rundt 50% av vintersesongen. Rundt 30% av skredulykker.</string>

    <string name="danger_level_3_number">3</string>
    <string name="danger_level_3_title">- Betydelig</string>
    <string name="danger_level_3_description">Farlige skredforhold.\n\nUtløsning er mulig, selv ved liten tilleggsbelastning, spesielt i bratte heng som er angitt. I enkelte situasjoner kan noen store, og i isolerte tilfeller svært store naturlige skred forekomme.\n\nTypiske faresignaler:\nFersk skredaktivitet, sprekker og \'drønn\' i snøen. Fjernutløsning er typisk, spesielt dersom vedvarende svakt lag er et av skredproblemene.\n\nVarslet rundt 30% av vintersesongen. Rundt 50% av skredulykker.</string>

    <string name="danger_level_4_number">4</string>
    <string name="danger_level_4_title">- Høy</string>
    <string name="danger_level_4_description">Svært farlige skredforhold.\n\nUtløsning er sannsynlig, selv ved liten tilleggsbelastning, i mange bratte heng. I noen tilfeller kan mange store og ofte svært store naturlige skred forventes.\n\nTypiske faresignaler:\nUtbredt fersk skredaktivitet, sprekker og \'drønn\' i snøen. Fjernutløsning er typisk.\n\nVarsles kun noen få dager i løpet av vinteren. Rundt 10% av skredulykker.</string>

    <string name="danger_level_5_number">5</string>
    <string name="danger_level_5_title">- Svært høy</string>
    <string name="danger_level_5_description">Ekstreme skredforhold.\n\nMange svært store og ofte ekstremt store naturlige skred kan forventes, selv i moderat bratt terreng.\n\nSvært sjelden varslet.</string>

